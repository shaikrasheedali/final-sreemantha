{
  "name": "sreemantha-hospital-platform",
  "version": "1.0.0",
  "description": "Sreemantha Hospital - Fertility, Women & Child Care Platform & CMS",
  "private": true,
  "main": "backend/src/server.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node backend/src/server.js",
    "predev": "npm run build:frontend",
    "start": "node backend/src/server.js",
    "server": "node backend/src/server.js",
    "build": "npm run build:frontend",
    "build:frontend": "npm --workspace frontend run build",
    "install:all": "npm install",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "test:backend": "npm --workspace backend test",
    "test:e2e": "playwright test",
    "test": "npm run test:backend && npm run test:e2e",
    "validate:deploy": "node scripts/validate-deploy.js"
  },
  "keywords": [
    "healthcare",
    "hospital",
    "fertility",
    "ivf",
    "pediatrics",
    "khammam",
    "cms",
    "express",
    "react",
    "mysql"
  ],
  "author": "Sreemantha Hospital Medical Engineering Team",
  "license": "ISC",
  "dependencies": {
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
