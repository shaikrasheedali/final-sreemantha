# ========================================================
# GoDaddy Hosted MySQL Database Environment Variables
# ========================================================
# When a hosted database is attached in GoDaddy, DB_HOST, DB_PORT,
# DB_NAME, DB_USER, and DB_PASSWORD are set for you automatically
# in the Secrets card. You do not need to override them in production.
# ========================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=false

# Application Server
PORT=5000
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_change_in_production
