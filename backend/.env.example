# ---------------------------------------------------------------------------
# Sreemantha Hospital Platform - local environment example
# Copy this file to backend/.env for local development.
# Never commit a real .env file or real secrets.
# ---------------------------------------------------------------------------

# HTTP server
# GoDaddy sets PORT automatically in preview and production.
PORT=5000
NODE_ENV=development

# Authentication
# Use a long random value in production (for example: openssl rand -hex 48).
# If omitted, the app generates and persists one under backend/data/.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# GoDaddy Hosted MySQL
# In GoDaddy these five values are injected automatically when the database
# is attached. Set them locally only if you run MySQL on your machine.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sreemantha_db
DB_USER=root
DB_PASSWORD=
# Set DB_SSL=true only when the database endpoint requires TLS.
DB_SSL=false
# Optional connection timeout in milliseconds.
DB_CONNECT_TIMEOUT_MS=10000

# Media uploads
# Defaults to backend/uploads. Point this at a persistent volume in production
# if the hosting filesystem is replaced on deploy.
# UPLOAD_DIR=

# Initial accounts (used only when the users table is empty).
# Change these before the first production deploy.
# SEED_SUPERADMIN_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=

# Logging: error | warn | info | http | debug
# LOG_LEVEL=debug
